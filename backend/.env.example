# ─── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list or JSON array of allowed origins (zero "*" wildcards)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional explicit frontend production domain (e.g. https://deepfake-agentic-ai.vercel.app)
FRONTEND_URL=
# Vercel preview domain regex (matches https://*.vercel.app)
VERCEL_PREVIEW_REGEX=^https:\/\/.*\.vercel\.app$

# ─── Model ────────────────────────────────────────────────────────────────────
MODEL_PATH=models/detector.pth
MODEL_DEVICE=cpu
CONFIDENCE_THRESHOLD=0.5

# ─── Storage (Phase 2.1) ───────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
# MinIO / Cloudflare R2 S3-compatible configuration (if STORAGE_BACKEND=minio)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=liveness-clips
MINIO_SECURE=false

# ─── Access Control & Video Stream Security ────────────────────────────────────
# Master secret for reviewer portal authentication (passed in X-Reviewer-Token header)
REVIEWER_TOKEN=reviewer_secret_token_change_in_production
# Independent HMAC-SHA256 signing secret for short-lived video stream URLs
# If left blank, falls back to REVIEWER_TOKEN
STREAM_SIGNING_KEY=stream_signing_secret_change_in_production
REVIEW_URL_EXPIRY_SECONDS=600

# ─── LLM (optional — used by LangGraph for natural language summaries) ────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
